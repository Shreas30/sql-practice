
-- LeetCode 197: Rising Temperature
-- Difficulty: Easy
-- Concept: SELF JOIN, DATEDIFF()
-- Approach: Join Weather with itself to compare each day
-- with the previous calendar day and check for higher temperature.

SELECT w1.id
FROM Weather w1
JOIN Weather w2
    ON DATEDIFF(w1.recordDate, w2.recordDate) = 1
WHERE w1.temperature > w2.temperature;
